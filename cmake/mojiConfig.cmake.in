@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)

# Bundled builds export their own moji::boost_* targets. Package builds need
# the consumer's Boost installation, including static-library link dependencies.
if(NOT @moji_FETCH_BOOST@)
    find_dependency(Boost 1.85 CONFIG COMPONENTS headers system json url)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/mojiTargets.cmake")
